FROM ghcr.io/nvidia/mirrors/nvidia-cuda-13.1.0-devel-ubuntu22.04

ENV ACH_TUTORIAL=sim2real-blogs \
    PYTHON_VERSION=3.12 \
    PIP_ROOT_USER_ACTION=ignore \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    MPLCONFIGDIR=/tmp/matplotlib_cache \
    MUJOCO_GL=egl \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility,graphics \
    VIRTUAL_ENV_DISABLE_PROMPT=1 \
    PATH=/usr/local/nvidia/bin:/usr/local/cuda/bin:${PATH}

# Install system packages (needed before pip install for git-based packages)
RUN apt-get update -y \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    git \
    git-lfs \
    apt-transport-https \
    ca-certificates \
    curl \
    gnupg \
    lsb-release \
    gosu \
    libglib2.0-0 \
    libegl1 \
    libgl1 \
    sudo \
 && apt-get clean -y \
 && rm -rf /var/lib/apt/lists/*

# Enable passwordless sudo for all users and pass through environment and path
RUN echo 'ALL ALL=(ALL) NOPASSWD:ALL' >> /etc/sudoers \
 && sed -i -e 's/^Defaults\s*env_reset/Defaults !env_reset/' -e 's/^Defaults\s*secure_path=/#&/' /etc/sudoers

# Install Python
RUN curl -fsSL https://keyserver.ubuntu.com/pks/lookup?op=get\&search=0xBA6932366A755776 | gpg --dearmor -o /usr/share/keyrings/deadsnakes.gpg \
 && echo "deb [signed-by=/usr/share/keyrings/deadsnakes.gpg] http://ppa.launchpad.net/deadsnakes/ppa/ubuntu jammy main" > /etc/apt/sources.list.d/deadsnakes-ppa.list \
 && apt-get update -y \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    python${PYTHON_VERSION} \
    python${PYTHON_VERSION}-dev \
 && curl -sS https://bootstrap.pypa.io/get-pip.py | python${PYTHON_VERSION} \
 && ln -sf /usr/bin/python${PYTHON_VERSION} /usr/bin/python3 \
 && ln -sf /usr/bin/python3 /usr/bin/python \
 && ln -s /usr/local/bin/pip /usr/bin/pip \
 && rm -f /usr/lib/python3.*/EXTERNALLY-MANAGED \
 && rm -rf /var/lib/apt/lists/*

# Use the measured Blog 2 dependency line, unchanged from the source archive.
# The previous Hub image used MuJoCo 3.12 / Warp 1.17; those are not these results.
COPY tutorials/${ACH_TUTORIAL}/notebooks/mujoco/requirements.lock.txt /opt/physics.lock.txt
COPY tutorials/${ACH_TUTORIAL}/brev/requirements.txt /opt/requirements.txt

# UI tools may add packages but cannot upgrade the locked physics dependencies.
RUN pip install --no-cache-dir --root-user-action=ignore --require-hashes -r /opt/physics.lock.txt \
 && pip freeze > /opt/locked-constraints.txt \
 && pip install --no-cache-dir --root-user-action=ignore -c /opt/locked-constraints.txt -r /opt/requirements.txt \
 && pip check \
 && rm -f /opt/requirements.txt /opt/physics.lock.txt /opt/locked-constraints.txt

# Disable unnecessary default Jupyter extensions.
RUN python -m jupyter labextension disable "@jupyterlab/apputils-extension:announcements" \
 && python -m jupyter labextension disable "@jupyterlab/console-extension:tracker"

COPY --chmod=0777 . /accelerated-computing-hub

WORKDIR /accelerated-computing-hub/tutorials/${ACH_TUTORIAL}/notebooks

ENTRYPOINT ["/accelerated-computing-hub/brev/entrypoint.bash", "jupyter"]
